! Generated by write_qe_input.sh v1.0 for Quantum ESPRESSO 7.4.1
! Verify pseudopotential compatibility and cutoff/k-point convergence.
&CONTROL
  calculation = 'scf',
  prefix = 'fe',
  outdir = './outputs',
  pseudo_dir = './pseudo',
/
&SYSTEM
  ibrav = 0,
  nat = 1,
  ntyp = 1,
  ecutwfc = 160,
  ecutrho = 640,
  nspin = 2,
  starting_magnetization(1) = 3,
  occupations = 'smearing',
  smearing = 'cold',
  degauss = 0.02,
/
&ELECTRONS
  conv_thr = 1e-10,
  electron_maxstep = 200,
  mixing_beta = 0.3,
/
ATOMIC_SPECIES
Fe 55.845 Fe.upf
ATOMIC_POSITIONS crystal
Fe 0 0 0
K_POINTS automatic
15 15 15 0 0 0
CELL_PARAMETERS angstrom
-1.415 1.415 1.415
1.415 -1.415 1.415
1.415 1.415 -1.415
