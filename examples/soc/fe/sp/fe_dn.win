! bcc Fe nosoc, spin down channel
num_wann  = 9
num_bands = 26
exclude_bands = 1-4      ! Fe 3s,3p semicore

fermi_energy  = 18.5839
! windows: same absolute values in fe_up / fe_dn / fe(SOC) .win (SOC window = union of SP windows)
dis_win_min   = 3.5000      ! below the lowest kept band (10.14 eV)
dis_win_max   = 65.0000     ! ~E_F + 46 eV; must stay above the p-like Gamma15 states (~51.5 eV): <= 55 eV breaks the fit
dis_froz_max  = 24.5000     ! ~E_F + 6 eV; plateau 24.0-25.5 eV, band 7 starts being frozen near 26 eV (worse)

dis_num_iter    = 2000
dis_conv_tol    = 1.0E-8
num_iter        = 500
conv_tol        = 1.0E-10
conv_window     = 5
guiding_centres = .true.

write_hr   = .true.
write_xyz  = .true.
write_u_matrices = .true.

begin unit_cell_cart
Ang
   -1.415   1.415   1.415
    1.415  -1.415   1.415
    1.415   1.415  -1.415
end unit_cell_cart

begin atoms_frac
Fe  0.0  0.0  0.0
end atoms_frac

begin projections
Fe : s; p; d
end projections

mp_grid = 10 10 10
